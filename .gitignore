# Secrets and local environment files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Python virtual environments and caches
.venv/
venv/
backend/.venv/
backend/venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
backend/.mypy_cache/
.ruff_cache/
backend/.ruff_cache/
.tox/
backend/.tox/
.nox/
backend/.nox/
.hypothesis/
backend/.hypothesis/
.coverage
.coverage.*
backend/.coverage
backend/.coverage.*
htmlcov/
backend/htmlcov/
*.egg-info/
backend/**/*.egg-info/
pip-wheel-metadata/

# Backend runtime data
backend/data/*.db
backend/data/*.sqlite*
backend/data/*.sqlite3
backend/data/*.db-journal

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

